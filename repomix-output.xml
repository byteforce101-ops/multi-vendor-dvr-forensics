            bg-[#f5efe4]
          "
        >

          <div>

            <div
              className="
                flex items-center gap-2
              "
            >

              <span
                className={`
                  inline-block
                  w-2.5 h-2.5
                  rounded-full
                  ${
                    error
                      ? 'bg-[#c2593f]'
                      : 'bg-[#3b5749] animate-pulse'
                  }
                `}
              />

              <h3
                className="
                  text-[18px]
                  font-semibold
                  text-[#221e1b]
                  font-['DM_Sans',sans-serif]
                "
              >
                Forensic Pipeline Execution
              </h3>

            </div>


            <p
              className="
                text-xs
                text-[#6e6459]
                font-mono
                mt-0.5
              "
            >

              Case:{' '}

              <span
                className="
                  font-semibold
                  text-[#221e1b]
                "
              >
                {caseName}
              </span>

              {' • '}

              Evidence:{' '}

              <span
                className="
                  font-semibold
                  text-[#221e1b]
                "
              >
                {evidenceId}
              </span>

              {' • '}

              File:{' '}

              <span
                className="
                  font-semibold
                  text-[#221e1b]
                "
              >
                {fileName}
              </span>

            </p>

          </div>


          <button
            onClick={onClose}
            className="
              p-1.5
              text-[#8c8275]
              hover:text-[#221e1b]
              rounded-lg
              hover:bg-black/5
