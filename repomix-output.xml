from sqlalchemy.orm import Session
from backend.db.models.event import Event as EventModel  # adjust import path/name to your actual model

class EventsRepository:
    def __init__(self, db: Session):
        self.db = db

    def search_events(self, case_id, event_types=None, start_time=None,
                       end_time=None, camera_id=None, min_confidence=None):
        query = self.db.query(EventModel).filter(EventModel.case_id == case_id)
        if event_types:
            query = query.filter(EventModel.event_type.in_(event_types))
        if start_time:
            query = query.filter(EventModel.timestamp >= start_time)
        if end_time:
            query = query.filter(EventModel.timestamp <= end_time)
        if camera_id:
            query = query.filter(EventModel.camera_id == camera_id)
        if min_confidence:
            query = query.filter(EventModel.confidence >= min_confidence)
        return query.order_by(EventModel.timestamp).all()
