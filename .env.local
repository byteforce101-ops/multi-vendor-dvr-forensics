VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://cgkicghtngbyaxibkspg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Wgk3HJBnoSqxAz8-KBXxlQ_JVE6Tc7g

# Local development (the default is SQLite, but defining this makes it explicit)
DATABASE_URL=sqlite:///backend/forensics.db

# Supabase production example. Use the server-side Postgres connection string.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=

# Backend only: never expose this value to the frontend or commit it.
SUPABASE_JWT_SECRET=
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Original evidence must remain in controlled, immutable evidence storage.
ORIGINAL_EVIDENCE_ROOT=backend/storage/original
WORKING_COPY_ROOT=backend/storage/working_copies

# Use local now. A later video-processing adapter can upload derived media to a
# private Supabase Storage bucket and save its object key in extracted_path.
DERIVED_MEDIA_PROVIDER=local
EXTRACTED_MEDIA_ROOT=backend/storage/extracted
    