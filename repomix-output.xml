@import url('https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap');
@import "tailwindcss";

@variant dark (&:where(.dark, .dark *));

@theme inline {
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --color-bg: #F7F9F8;
  --color-panel: #FFFFFF;
  --color-txt: #203541;
  --color-txt2: #65747B;
  --color-brd: #D8E1DD;
  --color-sidebar: #172630;
  --color-sidebar-hover: #1e3040;
  --color-teal: #41636E;
  --color-teal-light: #EBF2F4;
  --color-mgreen: #3E6757;
  --color-amber: #A06B21;
  --color-amber-light: #FDF3E7;
  --color-crit: #A94438;
  --color-crit-light: #FCECEA;
  --color-pass: #3E6757;
  --color-pass-light: #EAF2EE;
}

.dark {
  --color-bg: #0E171D;
  --color-panel: #15232C;
  --color-txt: #C5D8E2;
  --color-txt2: #7A9EAE;
  --color-brd: #263B45;
  --color-sidebar: #0B131A;
  --color-sidebar-hover: #15232C;
  --color-teal-light: #1a3540;
  --color-amber-light: #2a1f0a;
  --color-crit-light: #2a1212;
  --color-pass-light: #0f261e;
}

body { font-family: var(--font-sans); color: var(--color-txt); background: var(--color-bg); }
* { box-sizing: border-box; }

.mono { font-family: var(--font-mono); font-feature-settings: 'tnum' 1; }

/* keep these small utility classes — you'll use them everywhere below */
.sidebar-item {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 12px; border-radius: 4px; font-size: 13px; font-weight: 450;
  color: #8ba7b4; cursor: pointer; transition: background .12s, color .12s;
  border-left: 2px solid transparent;
}
.sidebar-item:hover { background: var(--color-sidebar-hover); color: #c5d8e2; }
.sidebar-item.active { background: rgba(65,99,110,.25); color: #7ec8d8; border-left-color: #41636E; }

table { border-collapse: collapse; width: 100%; }
th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em;
     color: var(--color-txt2); padding: 8px 12px; border-bottom: 1px solid var(--color-brd); white-space: nowrap; }
td { padding: 9px 12px; font-size: 13px; color: var(--color-txt); border-bottom: 1px solid var(--color-brd); }
tr:hover td { background: var(--color-teal-light); }

.badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 3px;
         font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
.badge-pass { background: var(--color-pass-light); color: var(--color-pass); }
.badge-amber { background: var(--color-amber-light); color: var(--color-amber); }
.badge-crit { background: var(--color-crit-light); color: var(--color-crit); }
.badge-neutral { background: var(--color-teal-light); color: var(--color-teal); }
</file>

