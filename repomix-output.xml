@media (max-width: 850px) { .section-shell, .site-footer { width: min(100% - 40px, 620px); }.site-header { width: calc(100% - 40px); }.main-nav { display: none; }.hero-section { min-height: 720px; padding: 165px 20px 70px; }.hero-content { width: min(550px, 100%); }.globe-wrap { opacity: .4; right: -120px; top: 200px; transform: scale(.78); transform-origin: top right; }.hero-footer { left: 20px; right: 20px; }.upload-section { display: block; padding-top: 85px; padding-bottom: 90px; }.section-intro { padding: 0; margin-bottom: 45px; }.upload-card { padding: 36px 22px; }.statement-inner { padding-top: 85px; padding-bottom: 85px; }.capabilities-section { padding-top: 85px; padding-bottom: 100px; }.section-heading { display: block; margin-bottom: 45px; }.section-heading > p { margin-top: 28px; }.feature-grid { grid-template-columns: repeat(2, 1fr); }.feature-card:nth-child(2) { border-right: 0; margin-right: 0; }.feature-card:nth-child(-n+2) { border-bottom: 1px solid var(--line); }.feature-card { padding: 22px 18px 30px 0; margin-right: 18px; }.feature-card:nth-child(even) { padding-left: 18px; padding-right: 0; }.process-section { padding-bottom: 100px; }.closing-orb { right: -140px; opacity: .55; }.site-footer { gap: 18px; flex-wrap: wrap; padding: 24px 0; }.site-footer > span:nth-child(2) { display: none; } }
@media (max-width: 500px) { .site-header { height: 68px; }.header-action { font-size: 0; border: 0; }.header-action svg { width: 19px; height: 19px; }.hero-section { min-height: 680px; padding-top: 135px; }.hero-content h1 { font-size: 61px; }.hero-copy { font-size: 13px; }.hero-links { align-items: start; flex-direction: column; gap: 22px; }.globe-wrap { right: -185px; top: 280px; transform: scale(.66); }.hero-footer { font-size: 8px; }.section-intro h2, .section-heading h2 { font-size: 44px; }.statement-inner h2 { font-size: 50px; }.statement-bottom { display: block; }.statement-bottom .quiet-link { margin-top: 25px; }.feature-grid { grid-template-columns: 1fr; }.feature-card, .feature-card:nth-child(even) { border-right: 0; border-bottom: 1px solid var(--line); margin: 0; padding: 24px 0 30px; }.feature-card:last-child { border-bottom: 0; }.feature-top { margin-bottom: 35px; }.timeline { padding-left: 29px; }.timeline-item { grid-template-columns: 1fr 42px; gap: 12px; min-height: 140px; }.timeline-number { position: absolute; left: -29px; top: 0; }.timeline-item::before { left: -34px; }.timeline-progress { left: -1px; }.timeline-item h3 { font-size: 16px; }.timeline-icon { grid-column: 2; grid-row: 1; }.closing-inner { padding-top: 75px; }.closing-orb { right: -220px; top: -110px; }.site-footer { width: calc(100% - 40px); } }
