@app.post(
    "/evidence/{evidence_id}/parse",
    response_model=EvidenceRead,
)
def parse_evidence(
    evidence_id: str,
    db: Session = Depends(get_db),
    user: AuthenticatedUser | None = Depends(
        get_current_user
    ),
):

    evidence = db.get(
        Evidence,
        evidence_id,
    )

    if not evidence:
        raise HTTPException(
            status_code=404,
            detail="Evidence not found",
        )

    _require_case_access(
        evidence.case,
        user,
    )

    output_dir = str(
        get_settings().extracted_media_root
        / evidence_id
    )

    _, _, device_info = parser_manager.detect(
        evidence.working_copy_path
    )

    result = parser_manager.parse(
        evidence.working_copy_path,
        output_dir,
    )

    persist_parse_result(
        db,
        evidence,
        result,
        device_info,
    )

    db.refresh(evidence)

    return evidence


