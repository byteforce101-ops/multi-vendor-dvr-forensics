    UNSUPPORTED_VENDOR = 3
    CORRUPTED_EVIDENCE = 4
    DATABASE_ERROR = 5
    EXTRACTION_FAILED = 6
    MISSING_DEPENDENCY = 7
    INVALID_ARGUMENT = 8
    NOT_FOUND = 9
