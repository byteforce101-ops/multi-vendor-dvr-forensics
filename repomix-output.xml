                  }
                `}
                style={{
                  width: `${progress}%`,
                }}
              />

            </div>

          </div>


          {/* ===================================================
              PHASES
          =================================================== */}

          <div
            className="
              grid
              grid-cols-2
              sm:grid-cols-4
              gap-3
              text-center
