            "Case ID",
            evidence.case_id,
        )

        table.add_row(
            "Filename",
            evidence.original_filename,
        )

        table.add_row(
            "Mode",
            mode,
        )

        table.add_row(
            "Original Path",
            evidence.original_path,
        )

        table.add_row(
            "Working Path",
            evidence.working_copy_path,
        )

        table.add_row(
            "SHA-256",
            evidence.sha256 or "Not available",
        )

        table.add_row(
            "MD5",
            evidence.md5 or "Not available",
