@app.post(
    "/evidence/{evidence_id}/extract",
    response_model=EvidenceRead,
)
def extract_evidence(
    evidence_id: str,
    db: Session = Depends(get_db),
    user: AuthenticatedUser | None = Depends(
        get_current_user
    ),
):

    evidence = db.get(
        Evidence,
        evidence_id,
    )

    if not evidence:
        raise HTTPException(
            status_code=404,
            detail="Evidence not found",
        )

    _require_case_access(
        evidence.case,
        user,
    )

    output_dir = str(
        get_settings().extracted_media_root
        / evidence_id
    )

    parse_result = parser_manager.parse(
        evidence.working_copy_path,
        output_dir,
    )

    if not parse_result.success:

        raise HTTPException(
            status_code=422,
            detail=(
                "Parse failed before extraction: "
                f"{parse_result.errors}"
            ),
        )

    extract_result = parser_manager.extract(
        evidence.working_copy_path,
        output_dir,
        parse_result,
    )

    _, _, device_info = parser_manager.detect(
        evidence.working_copy_path
    )

    persist_parse_result(
        db,
        evidence,
        extract_result,
        device_info,
    )

    db.refresh(evidence)

    return evidence

