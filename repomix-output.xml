@app.get(
    "/cases",
    response_model=list[CaseRead],
)
def list_cases(
    db: Session = Depends(get_db),
    user: AuthenticatedUser | None = Depends(
        get_current_user
    ),
):

    query = db.query(Case)

    if user is not None:
        query = query.filter(
            Case.owner_auth_id == user.user_id
        )

    return query.order_by(
        Case.created_at.desc()
    ).all()


