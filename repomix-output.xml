    if not parse_result.success:

        raise HTTPException(
            status_code=422,
            detail=(
                "Parse failed before extraction: "
                f"{parse_result.errors}"
            ),
        )

    extract_result = parser_manager.extract(
        evidence.working_copy_path,
        output_dir,
        parse_result,
    )

    _, _, device_info = parser_manager.detect(
        evidence.working_copy_path
    )

    persist_parse_result(
        db,
        evidence,
        extract_result,
        device_info,
    )

    db.refresh(evidence)

    return evidence


