from backend.core.custody.service import CustodyService  # adjust to your actual custody module
from backend.core.search.service import SearchService

router = APIRouter(prefix="/api/evidence", tags=["search"])


class SearchRequest(BaseModel):
    case_id: str
    query: str


def get_current_user_id() -> str:
    # placeholder until this is wired to real auth
    return "dev-user"


def get_search_service(db: Session = Depends(get_db)) -> SearchService:
    events_repo = EventsRepository(db)
    custody_service = CustodyService(db)  # adjust constructor args to match your CustodyService
    return SearchService(events_repo, custody_service)


@router.post("/search")
def search_evidence(
    req: SearchRequest,
    user_id: str = Depends(get_current_user_id),
