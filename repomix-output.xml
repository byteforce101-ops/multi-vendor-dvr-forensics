def _require_case_access(
    case: Case,
    user: AuthenticatedUser | None,
) -> None:

    if (
        user
        and case.owner_auth_id
        and case.owner_auth_id != user.user_id
    ):
        raise HTTPException(
            status_code=403,
            detail="You do not have access to this case",
        )


