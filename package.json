{
  "name": "multi-vendor-dvr-forensics",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -c \"blue.bold,green.bold\" -n \"BACKEND,FRONTEND\" \"node run-backend.js\" \"npm --prefix frontend run dev:vite\"",
    "backend": "node run-backend.js",
    "frontend": "npm --prefix frontend run dev:vite",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5"
  }
}
