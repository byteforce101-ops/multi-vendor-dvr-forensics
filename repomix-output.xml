        print("AI detection JSON not found:")
        print(JSON_PATH)
        return

    with open(
        JSON_PATH,
        "r",
        encoding="utf-8",
    ) as file:
        raw_detections = json.load(file)

    print()
    print("Raw detections:", len(raw_detections))

    # Temporary base time for testing.
